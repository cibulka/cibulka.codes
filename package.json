{
  "name": "cibulka.codes",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "overrides": {
    "next-contentlayer2": {
      "next": "$next"
    }
  },
  "scripts": {
    "dev": "concurrently --raw \"next dev\" \"npm run watch:i18n:extract\" \"npm run watch:i18n:compile\"",
    "prebuild": "npm run i18n:extract && npm run i18n:compile",
    "build": "next build",
    "i18n:extract": "tsx lib/scripts/i18n/extract.ts",
    "i18n:compile": "tsx lib/scripts/i18n/compile.ts",
    "watch:i18n:extract": "nodemon -q --watch 'messages.ts' --exec 'npm run i18n:extract'",
    "watch:i18n:compile": "nodemon -q --watch 'messages/*.json' --exec 'npm run i18n:compile'",
    "cv": "tsx lib/scripts/cv/cv.ts",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@vercel/analytics": "^1.3.1",
    "@vercel/og": "^0.6.2",
    "csshake": "^1.7.0",
    "dayjs": "^1.11.12",
    "next": "^15.5.9",
    "next-i18n-router": "^5.5.1",
    "next-plausible": "^3.12.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-intl": "^8.1.0",
    "react-range": "^1.9.2",
    "react-tetris-ts": "1.2.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@formatjs/cli": "^6.3.15",
    "@types/node": "^25",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "contentlayer2": "^0.5.8",
    "eslint": "^9",
    "eslint-config-next": "15.5.9",
    "eslint-plugin-formatjs": "^5.2.8",
    "execa": "9.3.0",
    "next-contentlayer2": "^0.5.8",
    "nodemon": "^3.1.4",
    "ora": "^8.0.1",
    "postcss": "^8",
    "puppeteer": "^22.13.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.16.5",
    "typescript": "^5"
  }
}
